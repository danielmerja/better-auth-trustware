# Trustware API key. Server-side only, never ship it to the browser.
TRUSTWARE_API_KEY=

# The wallet that receives settled payments.
MERCHANT_ADDRESS=

# Shared secret for scheduler calls to /api/auth/trustware/reconcile (Vercel sends CRON_SECRET as a bearer token).
CRON_SECRET=

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
